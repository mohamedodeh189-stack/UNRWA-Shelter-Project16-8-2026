<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.unrwa.yarmoukfield">
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Package-visibility declaration (Android 11+ / API 30+ — this app targets 36): without this,
         PackageManager.resolveActivity()/queryIntentActivities() cannot see ANY navigation app —
         including an installed Google Maps — for a geo: Intent.ACTION_VIEW, so "فتح الموقع للملاحة"
         always reported "no navigation app" even when one was installed. This is a visibility
         declaration only — it grants no network access and adds no INTERNET permission, and it never
         names one specific app, so any installed app that handles geo: (Google Maps, OsmAnd, etc.)
         becomes visible to the check. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- HOUSE DRAWING MODULE (M1/M2). android:exported="true" is a TEMPORARY test affordance so the
             screen can be launched via `adb am start` during development — set exported="false" (and launch
             it only from the beneficiary file) at M8 / before any release. See docs/HOUSE_DRAWING_MODULE_SPEC.md -->
        <activity
            android:name=".drawing.HouseDrawActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SequentialCameraActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait" />
        <provider
            android:name=".CadFileProvider"
            android:authorities="org.unrwa.yarmoukfield.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name=".sync.SyncFileProvider"
            android:authorities="org.unrwa.yarmoukfield.sync.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
